REDIS_URL=redis://127.0.0.1:6379
# Must match the gateway's QUEUE_PREFIX.
QUEUE_PREFIX=queue
QUEUE_NAME=billing
# Queue of the customer daemon (asked for customer references when seeding).
CUSTOMERS_QUEUE=customers
# Queue of the subscription daemon (on first boot, history waits for its lines).
SUBSCRIPTIONS_QUEUE=subscriptions
# Queue of the usage daemon (usage totals for out-of-bundle extras; billing runs wait for it).
USAGE_QUEUE=usage
CONCURRENCY=10

DATABASE_PATH=data/billing.sqlite
# Business time zone: what "today" is and when the daily run fires.
TIMEZONE=Europe/London
DAILY_RUN_CRON="0 2 * * *"
MAX_CATCH_UP_DAYS=400

# Seed accounts for every customer on first boot, then replay BACKFILL_DAYS of billing for history.
SEED_ON_EMPTY=true
SEED=1
BACKFILL_DAYS=90
